{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catherine-birthday",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths reach the Worker; everything else is served straight from ./public
    "run_worker_first": ["/api/*", "/draft/*", "/reset/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DRAFT", "class_name": "Draft" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Draft"] }
  ]
}
